{
  "name": "crabalyst",
  "version": "0.1.0",
  "description": "Crabalyst — five crab analysts watching the market so you don't have to",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "agent": "./bin/agent.mjs"
  },
  "scripts": {
    "dev": "tsx bin/agent.ts",
    "start": "tsx bin/agent.ts",
    "cli": "tsx bin/agent.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:unit": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "ws": "^8.21.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0"
  }
}
